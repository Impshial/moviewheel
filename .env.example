# Browser-safe configuration
# Project base URL only: https://<project-ref>.supabase.co (no /rest/v1 suffix).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only credentials. Never prefix these with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
OMDB_API_KEY=

# Generated ONCE by pnpm setup:env. Preserve for these accounts in every deployment.
PIN_AUTH_SECRET=

# Setup/maintenance only. Do not deploy these to Vercel.
SUPABASE_ACCESS_TOKEN=
SUPABASE_DB_PASSWORD=

# Optional: Vercel region matching the Supabase project, e.g. iad1. Set after inspection.
# Configure the function region in Vercel project settings; do not guess the region.
