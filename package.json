{
  "name": "movie-wheel",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "setup:env": "node scripts/setup-env.mjs",
    "setup:supabase": "node --env-file=.env.local scripts/setup-supabase.mjs",
    "maintenance:uploads": "node --env-file=.env.local scripts/cleanup-uploads.mjs",
    "maintenance:pin": "node --env-file=.env.local scripts/reset-pin.mjs"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-hover-card": "^1.1.23",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.2",
    "cookie": "^2.0.1",
    "linkify-it": "^6.1.0",
    "lucide-react": "^1.48.0",
    "luxon": "^3.7.2",
    "next": "^16.3.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "tus-js-client": "^4.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@eslint/compat": "^2.1.1",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/luxon": "^3.7.5",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.1",
    "eslint": "^10.11.0",
    "eslint-config-next": "^16.3.6",
    "jsdom": "^30.1.1",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "vitest": "^5.0.2",
    "ws": "^8.22.0"
  }
}
